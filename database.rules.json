{
  "rules": {
    "presence": {
      "$assignmentId": {
        ".read": "auth != null",
        "$studentUid": {
          ".write": "auth != null && auth.uid === $studentUid",
          ".validate": "newData.hasChildren(['state', 'lastActive'])",
          "state": {
            ".validate": "newData.isString() && newData.val().matches(/^(viewing|typing|away|offline)$/)"
          },
          "lastActive": {
            ".validate": "newData.val() === now"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}
